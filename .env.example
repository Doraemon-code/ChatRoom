# Exact LAN browser origins, comma-separated. Include the port when it is not 443.
ALLOWED_ORIGINS=https://chat.local
# 0.0.0.0 exposes the HTTPS edge on all LAN interfaces; use a specific server
# address to restrict it. The Relay port is never published.
BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
# Used only by the tmpfs self-signed fallback certificate.
CERT_HOSTS=chat.local,localhost,127.0.0.1
MAX_CONNECTIONS=2000
MAX_ROOMS=1000
MAX_MEMBERS_PER_ROOM=50
# Public forum data is stored as name/message/replies only.
FORUM_DATA_PATH=/data/forum.json
MAX_FORUM_POSTS=10000
